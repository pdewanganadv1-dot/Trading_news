# copy to .env and fill in - never commit this file
RELAY_TOKEN=change-me-long-random-string      # secret part of the webhook URL: https://<host>/tv/<RELAY_TOKEN>
DELTA_API_KEY=                                # from Delta Exchange India -> API keys (trading permission, IP whitelist)
DELTA_API_SECRET=
DELTA_BASE_URL=https://api.india.delta.exchange   # testnet (demo account): https://cdn-ind.testnet.deltaex.org
DRY_RUN=1                                     # 1 = log orders only, 0 = send them to Delta
STOP_TRIGGER=mark_price                       # or last_traded_price
MAX_QTY=BTCUSD=12,ETHUSD=40,XAUTUSD=200       # hard cap per symbol, any bigger alert is rejected
ALLOWED_SYMBOLS=BTCUSD,ETHUSD,XAUTUSD         # anything else is rejected
PORT=8080
